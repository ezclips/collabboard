# custom ignores
supabase/.temp/
tmp-line-debug/
devserver.out.log

# .agent/ holds local notes, with two deliberate exceptions. The verification
# baselines are a GATE CRITERION, not a note: the failing-test-file set is what a
# commit is judged against, so it has to travel with the code instead of living
# on one machine. The retrieval follow-ups are DEFERRED WORK WITH EVIDENCE --
# decisions taken, with the reasoning that justified deferring them; "remembered
# by whoever was in the session" has already cost this project twice.
# `.agent/*` rather than `.agent/` is what makes a negation possible at all --
# git will not descend into an ignored directory.
.agent/*
.claude/
!.agent/verification-baselines.md
!.agent/retrieval-followups.md

# local dev artifacts (Phase 0 hygiene)
tmp/
error_Logs/
devserver*.log
.next-dev*.log
*tsc_output.txt
Sakai_Investments/
*.bundle
test-results/
playwright-report/
e2e/.auth/
e2e/.artifacts/
.fable5/worktrees/
.fable5/evidence/

# Live browser profiles and capture output. These sit inside the project but
# hold RUNTIME state, not source: the persistent Playwright Chromium writes its
# cache here continuously. They are excluded from the dev watcher in
# next.config.ts for the same reason -- see the comment there.
.runtime-fixtures/
.playwright-mcp/
