# Deployment inputs only. Never put secret values in this file.
# Set these values in the operator shell or CI secret/configuration store.
GCP_PROJECT_ID=replace-with-gcp-project-id
GCP_REGION=replace-with-supported-cloud-run-region
IMAGE_DIGEST=sha256:replace-with-64-hexadecimal-digest
WORKER_POOL_NAME=collabboard-knowledge-pdf-worker
SERVICE_ACCOUNT_EMAIL=collabboard-knowledge-worker@replace-with-gcp-project-id.iam.gserviceaccount.com

# Secret names and one pinned version; these are not secret values.
SUPABASE_URL_SECRET_NAME=collabboard-supabase-url
SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME=collabboard-supabase-service-role-key
SUPABASE_SECRET_VERSION=1

# Initial sizing. CPU and memory may be changed after production metrics.
GCP_WORKER_CPU=2
GCP_WORKER_MEMORY=4Gi

# Existing worker configuration. These values match the current worker defaults.
KNOWLEDGE_PDF_WORKER_CONCURRENCY=2
KNOWLEDGE_PDF_POLL_INTERVAL_MS=5000
KNOWLEDGE_PDF_DISCOVERY_LIMIT=16
KNOWLEDGE_PROCESSING_LEASE_TTL_SECONDS=300
KNOWLEDGE_PROCESSING_HEARTBEAT_INTERVAL_MS=100000
OPENDATALOADER_TIMEOUT_MS=120000
