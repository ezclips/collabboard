# Preparation inputs only. Never put secret values in this file.
GCP_PROJECT_ID=callabboard
GCP_REGION=europe-west6
IMAGE_DIGEST=sha256:replace-with-64-lowercase-hex-digest
TEI_IMAGE_DIGEST=sha256:replace-with-64-lowercase-hex-digest
WORKER_POOL_NAME=collabboard-knowledge-embedding-worker
SERVICE_ACCOUNT_EMAIL=collabboard-embed-worker@callabboard.iam.gserviceaccount.com

# Secret names and independently pinned versions; values stay in Secret Manager.
SUPABASE_URL_SECRET_NAME=collabboard-supabase-url
SUPABASE_URL_SECRET_VERSION=1
SUPABASE_SERVICE_ROLE_KEY_SECRET_NAME=collabboard-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY_SECRET_VERSION=3

GCP_WORKER_INSTANCES=0
GCP_WORKER_CPU=1
GCP_WORKER_MEMORY=1Gi
GCP_TEI_CPU=2
GCP_TEI_MEMORY=3Gi
KNOWLEDGE_EMBEDDING_PROVIDER=local-tei
KNOWLEDGE_EMBEDDING_TEI_URL=http://127.0.0.1:8080
KNOWLEDGE_EMBEDDING_MODEL=voyageai/voyage-4-nano
KNOWLEDGE_EMBEDDING_MODEL_ID=local:voyage-4-nano
KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_EMBEDDING_BATCH_SIZE=16
KNOWLEDGE_EMBEDDING_POLL_INTERVAL_MS=5000
KNOWLEDGE_EMBEDDING_DISCOVERY_LIMIT=16
KNOWLEDGE_EMBEDDING_REQUEST_TIMEOUT_MS=30000
KNOWLEDGE_EMBEDDING_CREATED_AFTER=2026-08-21T22:06:19Z
